    fetchStockData["api.js fetchStockData | 每個標的並行抓取"]
    fetchYahooData["api.js fetchYahooData | 依序嘗試代理"]
    worker["Cloudflare Worker | 優先代理"]
    fallbackProxy["codetabs / allorigins | 備援代理"]
    yahooAPI["Yahoo Finance chart API"]
    suffixRetry[".TW ↔ .TWO 後綴互換重試"]
    buildAnalysis["buildAnalysisFromYahooData"]
    calcKD["indicators.js calculateKD | 盤中版與收盤版"]
    crossDetect["收盤版偵測近 4 根交叉，盤中版確認有效"]
    analyze["indicators.js analyzeData | 依類別規則給建議"]
