    collapse["applyCollapse | 套用類別摺疊"]
    settings["settings.js | 標的與類別管理、匯入匯出、排序"]

    index -->|window.onload| mainLoad
    state -->|targets / categories| mainLoad
    mainLoad --> skeleton
    skeleton -->|Promise.all| fetchStockData
    fetchStockData --> fetchYahooData
    fetchYahooData -->|第一順位| worker
    fetchYahooData -.->|失敗時| fallbackProxy
    worker --> yahooAPI
    fallbackProxy --> yahooAPI
    yahooAPI -->|chart JSON| fetchYahooData
    fetchYahooData -->|NOT_FOUND| suffixRetry
    suffixRetry --> fetchYahooData
    fetchYahooData -->|highs / lows / closes / meta| buildAnalysis
    buildAnalysis --> calcKD
    calcKD --> crossDetect
    crossDetect --> analyze
    analyze -->|買進 / 賣出 / 觀望| renderRow
    renderRow --> collapse
    collapse --> index
    settings -->|儲存後觸發 stock:reload| mainLoad
